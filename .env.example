# moviepick 로컬 개발 환경 설정
# 이 파일을 같은 폴더(프로젝트 맨 위)에 .env 로 복사해서 쓴다. .env는 저장소에 올라가지 않는다.
#   Windows PowerShell: Copy-Item .env.example .env
#   Mac·Linux:          cp .env.example .env
# docker compose와 Spring 앱이 같은 .env를 읽는다.
#
# 작성 규칙
# - 값에 따옴표를 쓰지 않는다.            (O) JWT_SECRET=abc   (X) JWT_SECRET="abc"
# - = 앞뒤에 공백을 넣지 않는다.          (O) MYSQL_PORT=3307  (X) MYSQL_PORT = 3307
# - DB 비밀번호(MYSQL_ROOT_PASSWORD, MYSQL_PASSWORD)는 바꾸지 말고 그대로 쓴다.
#   바꾸면 이미 만들어진 DB와 맞지 않아 docker compose down -v 후 다시 만들어야 한다.

# ---------- Docker MySQL (개발용 예시값, 로컬 PC에서만 접속 가능) ----------
MYSQL_ROOT_PASSWORD=moviepick-root-local
MYSQL_DATABASE=moviepick
MYSQL_USER=moviepick
MYSQL_PASSWORD=moviepick-local
# PC에 설치된 MySQL(3306)과 겹치지 않게 3307을 쓴다
MYSQL_PORT=3307

# ---------- Docker Redis ----------
# PC에 설치된 Redis와 겹치지 않게 6380을 쓴다
REDIS_PORT=6380

# ---------- 비밀값 (빈 칸으로 두고 각자 채운다. 절대 저장소에 올리지 않는다) ----------
# JWT 서명 키: Base64 문자열, 디코딩 후 32바이트 이상
JWT_SECRET=
# TMDB API 읽기 액세스 토큰:  영화 담당(김혁중)
TMDB_ACCESS_TOKEN=
# PortOne 결제 (테스트 채널): 후원 담당(강성현)
PORTONE_API_SECRET=
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_WEBHOOK_SECRET=
# 소셜 로그인: 인증 담당(박지민) 카카오 개발자 콘솔 / Google Cloud 콘솔
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
